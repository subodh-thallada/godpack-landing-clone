{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app",
      "destination": "/packs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(packs|battles|market|vault|feed|rewards|ship|add-funds|withdraw|profile)",
      "destination": "/app"
    },
    {
      "source": "/market/(l|t)/:id",
      "destination": "/app"
    },
    {
      "source": "/feed/following",
      "destination": "/app"
    },
    {
      "source": "/slab/:id",
      "destination": "/app"
    },
    {
      "source": "/profile/:handle",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(app/)?assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(app/)?(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
